{
 "theme": "base",
 "fontFamily": "Instrument Sans, Helvetica Neue, sans-serif",
 "flowchart": {
  "curve": "basis",
  "nodeSpacing": 50,
  "rankSpacing": 70,
  "padding": 22,
  "htmlLabels": false,
  "useMaxWidth": true,
  "wrappingWidth": 260
 },
 "htmlLabels": false,
 "themeVariables": {
  "background": "transparent",
  "primaryColor": "#161F3A",
  "primaryTextColor": "#E9EDF8",
  "primaryBorderColor": "#2A3757",
  "lineColor": "#55628A",
  "secondaryColor": "#141C34",
  "tertiaryColor": "#0F1528",
  "edgeLabelBackground": "#0F1528",
  "fontSize": "16px",
  "fontFamily": "Instrument Sans, Helvetica Neue, sans-serif",
  "taskBkgColor": "#2C3B63",
  "taskBorderColor": "#5A6FA8",
  "taskTextColor": "#E9EDF8",
  "taskTextOutsideColor": "#AAB6D4",
  "taskTextDarkColor": "#0B1020",
  "activeTaskBkgColor": "#FF6B3D",
  "activeTaskBorderColor": "#FF8A63",
  "doneTaskBkgColor": "#1E2A49",
  "doneTaskBorderColor": "#3A4A78",
  "critBkgColor": "#F5B942",
  "critBorderColor": "#FFCF6E",
  "sectionBkgColor": "#161F3A",
  "altSectionBkgColor": "#101728",
  "gridColor": "#1E2A47",
  "todayLineColor": "#FF6B3D"
 },
 "themeCSS": ".node .label,.node .label text,.nodeLabel{font-weight:500;letter-spacing:-0.011em}.node .label text tspan:first-child,.nodeLabel tspan:first-child{font-weight:700}.node rect,.node polygon,.node path{rx:16;ry:16;stroke-width:1.7px}.edgePath path,.flowchart-link{stroke-width:1.8px;opacity:.75}.cluster rect{rx:20;ry:20;stroke-dasharray:3 5;stroke-width:1.2px}.marker{opacity:.75}",
 "gantt": {
  "barHeight": 28,
  "barGap": 10,
  "topPadding": 62,
  "leftPadding": 116,
  "gridLineStartPadding": 40,
  "fontSize": 13,
  "sectionFontSize": 15,
  "numberSectionStyles": 4
 }
}